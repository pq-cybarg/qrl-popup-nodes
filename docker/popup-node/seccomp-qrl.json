                "socketcall",
                "socketpair"
            ],
            "action": "SCMP_ACT_ALLOW"
        },
        {
            "_comment": "Time + scheduling — Go's scheduler + clock, nanosleep is one of the top syscalls in the audit.",
            "names": [
                "adjtimex",
                "alarm",
                "clock_getres",
                "clock_getres_time64",
                "clock_gettime",
                "clock_gettime64",
                "clock_nanosleep",
