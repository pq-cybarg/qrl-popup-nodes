                "setreuid",
                "setreuid32",
                "setrlimit",
                "setsid",
                "setuid",
                "setuid32",
                "tgkill",
                "tkill",
                "ugetrlimit",
                "vfork",
                "wait4",
                "waitid"
            ],
            "action": "SCMP_ACT_ALLOW"
        },
        {
            "_comment": "Signal handling — Go's runtime installs a lot of signal handlers, uses sigaltstack for stack protection.",
            "names": [
                "pause",
                "rt_sigaction",
                "rt_sigpending",
                "rt_sigprocmask",
                "rt_sigqueueinfo",
                "rt_sigreturn",
                "rt_sigsuspend",
                "rt_sigtimedwait",
                "rt_tgsigqueueinfo",
                "sigaltstack"
            ],
            "action": "SCMP_ACT_ALLOW"
        },
        {
            "_comment": "Networking — beacon P2P (libp2p), gqrl P2P + engine API + HTTP JSON-RPC. Includes both stream + dgram paths.",
            "names": [
                "accept",
                "accept4",
                "bind",
                "connect",
                "getpeername",
                "getsockname",
                "getsockopt",
                "listen",
                "recv",
                "recvfrom",
                "recvmmsg",
                "recvmsg",
                "send",
                "sendmmsg",
                "sendmsg",
                "sendto",
                "setsockopt",
