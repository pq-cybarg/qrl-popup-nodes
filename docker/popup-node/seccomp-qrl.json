                "getitimer",
                "gettimeofday",
                "nanosleep",
                "sched_get_priority_max",
                "sched_get_priority_min",
                "sched_getaffinity",
                "sched_getattr",
                "sched_getparam",
                "sched_getscheduler",
                "sched_rr_get_interval",
                "sched_rr_get_interval_time64",
                "sched_setaffinity",
                "sched_setattr",
                "sched_setparam",
                "sched_setscheduler",
                "sched_yield",
                "setitimer",
                "time",
                "timer_create",
                "timer_delete",
                "timer_getoverrun",
                "timer_gettime",
                "timer_gettime64",
                "timer_settime",
                "timer_settime64",
                "times"
            ],
            "action": "SCMP_ACT_ALLOW"
        },
        {
            "_comment": "Sync primitives — futex is >77% of gqrl syscalls and >81% of beacon syscalls. This is where Go lives.",
            "names": [
                "futex",
                "futex_time64",
                "futex_waitv",
                "get_mempolicy",
                "mbind",
                "membarrier",
                "set_mempolicy"
            ],
            "action": "SCMP_ACT_ALLOW"
        },
        {
            "_comment": "Info + misc — uname is checked at startup, getcpu for Go's P-to-M pinning, ioctl for terminal probing.",
            "names": [
                "getcpu",
                "ioctl",
                "prlimit",
                "sysinfo",
                "uname"
            ],
            "action": "SCMP_ACT_ALLOW"
        }
    ]
}
