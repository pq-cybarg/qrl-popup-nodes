# Rootless-safe beacon-chain image for popup nodes.
#
# Same hardening rules as Dockerfile.gqrl. See docs/POPUP-NODES-ROOTLESS.md.
#
# Build:
#   docker build \
#     -f docker/popup-node/Dockerfile.beacon \
#     -t qrl-beacon:qrl-testing-branch .

# Base images pinned by digest — refresh via docker/refresh-base-digests.sh.
# See docker/BASE-IMAGE-DIGESTS.md for the "why" (supply-chain).
ARG BUILDER_IMAGE=golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59
ARG RUNTIME_IMAGE=alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# --- builder stage ------------------------------------------------------------

FROM ${BUILDER_IMAGE} AS builder

RUN apk add --no-cache gcc musl-dev linux-headers git

# QRYSM source path relative to repo root. Only one qrysm — variants are
# gqrl-side (execution precompiles). Beacon binary is variant-agnostic.
ARG QRYSM_PATH=qrl-2.0/upstream/qrysm
ARG GOQRL_PATH=qrl-2.0/upstream/go-qrl

# qrysm's go.mod has `replace github.com/theQRL/go-qrl => ../go-qrl`
# so we need to lay both trees out as siblings inside the builder,
# matching what the on-disk repo does:
#     /src/qrysm/    (primary build tree)
#     /src/go-qrl/   (replace target)
WORKDIR /src
COPY ${GOQRL_PATH}/ /src/go-qrl/
COPY ${QRYSM_PATH}/ /src/qrysm/

WORKDIR /src/qrysm
RUN if [ -f go.mod ]; then go mod download; fi

# Two binaries from this tree — beacon-chain (leader + followers) and
# qrysmctl (genesis generation, checkpoint sync, DB tooling). Ship both
# because the popup-node bring-up needs qrysmctl to regen genesis when
# the operator resets the chain.
RUN go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/beacon-chain ./cmd/beacon-chain \
    && go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/qrysmctl ./cmd/qrysmctl \
    && ls -la /out/

# --- runtime stage ------------------------------------------------------------

FROM ${RUNTIME_IMAGE} AS runtime

# curl+jq are here for the bootstrap-fetcher role (compose reuses this
# image with an entrypoint override to poll beacon-node1's REST gateway
# for its QNR). Also useful for in-container debugging.
RUN apk add --no-cache ca-certificates tini curl jq openssl

RUN addgroup -g 1000 qrl \
    && adduser -D -H -u 1000 -G qrl -s /sbin/nologin qrl

RUN mkdir -p /opt/qrl/bin /opt/qrl/data /opt/qrl/config /opt/qrl/bootstrap \
    && chown -R 1000:1000 /opt/qrl

COPY --from=builder --chown=1000:1000 /out/beacon-chain /opt/qrl/bin/beacon-chain
COPY --from=builder --chown=1000:1000 /out/qrysmctl     /opt/qrl/bin/qrysmctl
COPY --chown=1000:1000 --chmod=0755 docker/popup-node/beacon-entrypoint.sh /opt/qrl/bin/beacon-entrypoint.sh
COPY --chown=1000:1000 --chmod=0755 docker/popup-node/fetch-leader-qnr.sh  /opt/qrl/bin/fetch-leader-qnr.sh

# Drop any setuid/setgid bits (belt-and-suspenders).
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} + 2>/dev/null || true

USER 1000:1000
WORKDIR /opt/qrl

# All ports >1024. No CAP_NET_BIND_SERVICE needed.
#   4100  gRPC (validator client talks to this)
#   3600  REST gateway (/qrl/v1/... APIs)
#   13000 UDP  discv5
#   14000 TCP  libp2p
#   8180  Prometheus metrics
EXPOSE 4100 3600 14000/tcp 13000/udp 8180

# The wrapper detects the container's bridge IP and injects it as
# --p2p-host-ip so the QNR advertised on the wire is dialable. If
# /opt/qrl/bootstrap/leader.qnr exists (follower mount), it also injects
# --bootstrap-node so the follower dials the leader directly instead of
# relying on discv5 UDP / mDNS across the Docker bridge.
ENTRYPOINT ["/sbin/tini", "-g", "--", "/opt/qrl/bin/beacon-entrypoint.sh"]

# Sensible localnet defaults. Override with `command:` in compose or via
# `docker run beacon-chain <flags>`. `--jwt-secret` MUST point at a file
# mounted into /opt/qrl/config/ so the beacon and its paired EL agree.
# NOTE: --p2p-host-ip is intentionally NOT in CMD — the entrypoint
# wrapper injects it dynamically from the container's bridge IP.
CMD ["--datadir=/opt/qrl/data", \
     "--chain-config-file=/opt/qrl/config/config.yml", \
     "--genesis-state=/opt/qrl/config/genesis.ssz", \
     "--execution-endpoint=http://gqrl-node1:9551", \
     "--jwt-secret=/opt/qrl/config/jwtsecret", \
     "--contract-deployment-block=0", \
     "--interop-executiondata-votes", \
     "--disable-staking-contract-check", \
     "--minimum-peers-per-subnet=0", \
     "--min-sync-peers=0", \
     "--p2p-static-id", \
     "--p2p-local-ip=0.0.0.0", \
     "--p2p-udp-port=13000", "--p2p-tcp-port=14000", \
     "--grpc-gateway-port=3600", "--rpc-port=4100", \
     "--monitoring-port=8180", \
     "--accept-terms-of-use", \
     "--verbosity=info", "--log-format=text"]
